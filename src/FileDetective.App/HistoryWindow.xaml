<Window x:Class="FileDetective.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileDetective.App.ViewModels"
        xmlns:local="clr-namespace:FileDetective.App"
        Width="1220" Height="800" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate DataType="{x:Type vm:HistoryHeaderItem}">
        <TextBlock Text="{Binding Text}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Bottom"
                   Margin="10,0,0,6" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
      </DataTemplate>

      <DataTemplate DataType="{x:Type vm:HistoryTileRowItem}">
        <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False" Margin="4,0,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryTileItem}">
              <Border Width="140" Height="124" Margin="4" CornerRadius="6" BorderThickness="2"
                      ToolTip="{Binding ToolTipText}" SnapsToDevicePixels="True">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                    <Style.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource ChipBrush}" />
                      </Trigger>
                      <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid Margin="4">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <Image Source="{Binding Icon}" Width="32" Height="32" />
                    <TextBlock Text="{Binding CloudText}" Style="{StaticResource MutedText}" TextAlignment="Center"
                               Margin="0,4,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Row="1" Text="{Binding TimeText}" Style="{StaticResource MutedText}" FontSize="11"
                             HorizontalAlignment="Center" Margin="0,2,0,0" TextWrapping="NoWrap" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Search and folder filter -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid>
        <TextBox x:Name="SearchBox" FontSize="15" Padding="8,7" />
        <TextBlock x:Name="SearchPlaceholder" IsHitTestVisible="False" Margin="10,0,0,0" FontSize="15"
                   VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="NoWrap" />
      </Grid>
      <ComboBox x:Name="FolderBox" Grid.Column="1" Width="260" Margin="10,0,0,0" VerticalContentAlignment="Center" />
    </Grid>

    <!-- Hint while the text recognition is off or has no language -->
    <Border x:Name="Banner" Grid.Row="1" Margin="0,10,0,0" Padding="12,8" CornerRadius="6"
            Background="{StaticResource ChipBrush}" Visibility="Collapsed">
      <DockPanel LastChildFill="True">
        <Button x:Name="BannerButton" DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource PrimaryButton}" />
        <TextBlock x:Name="BannerText" VerticalAlignment="Center" Foreground="{StaticResource WarnBrush}" />
      </DockPanel>
    </Border>

    <!-- Grid of previews and text panel -->
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="300" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="340" MinWidth="240" />
      </Grid.ColumnDefinitions>

      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
              BorderThickness="1" CornerRadius="10" Padding="4,4,0,4" ClipToBounds="True">
        <Grid>
          <local:HistoryGridView x:Name="GridView">
            <local:HistoryGridView.ContextMenu>
              <ContextMenu x:Name="TileMenu">
                <MenuItem x:Name="MenuCopyImage" />
                <MenuItem x:Name="MenuCopyText" />
                <MenuItem x:Name="MenuOpen" />
                <MenuItem x:Name="MenuReveal" />
                <Separator />
                <MenuItem x:Name="MenuCopyPath" />
              </ContextMenu>
            </local:HistoryGridView.ContextMenu>
          </local:HistoryGridView>
          <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                     TextAlignment="Center" Style="{StaticResource MutedText}" FontSize="14" Visibility="Collapsed"
                     IsHitTestVisible="False" />
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    Background="Transparent" ResizeBehavior="PreviousAndNext" />

      <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
              BorderThickness="1" CornerRadius="10" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock x:Name="PanelName" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
            <TextBlock x:Name="PanelDate" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
            <TextBlock x:Name="PanelFolder" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
          </StackPanel>
          <WrapPanel Grid.Row="1" Margin="0,12,0,0">
            <Button x:Name="CopyImageButton" Padding="10,5" MinWidth="0" Margin="0,0,6,6" />
            <Button x:Name="CopyTextButton" Padding="10,5" MinWidth="0" Margin="0,0,6,6" />
            <Button x:Name="OpenButton" Padding="10,5" MinWidth="0" Margin="0,0,6,6" />
            <Button x:Name="RevealButton" Padding="10,5" MinWidth="0" Margin="0,0,6,6" />
          </WrapPanel>
          <TextBlock x:Name="TextHeading" Grid.Row="2" Style="{StaticResource LabelText}" Margin="0,8,0,4" />
          <RichTextBox x:Name="TextView" Grid.Row="3" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                       BorderThickness="0" Background="Transparent" Padding="0" IsDocumentEnabled="False">
            <RichTextBox.Document>
              <FlowDocument PagePadding="0" />
            </RichTextBox.Document>
          </RichTextBox>
        </Grid>
      </Border>
    </Grid>

    <!-- Status -->
    <Grid Grid.Row="3" Margin="2,10,2,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="KeysText" Grid.Column="1" Style="{StaticResource MutedText}" TextWrapping="NoWrap"
                 Margin="16,0,0,0" />
    </Grid>

  </Grid>
</Window>
