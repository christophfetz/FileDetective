<Window x:Class="FileDetective.App.DuplicatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileDetective.App.ViewModels"
        Width="1040" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

      <Style x:Key="RowStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Row" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="Transparent">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="#F3F5F7" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnRowRightClick" />
      </Style>

      <DataTemplate DataType="{x:Type vm:DuplicateGroupRow}">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,10,0,2" TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis" />
      </DataTemplate>

      <DataTemplate DataType="{x:Type vm:DuplicateFileRow}">
        <Grid ToolTip="{Binding File.FullPath}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="140" />
          </Grid.ColumnDefinitions>
          <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{Binding ShowCheckBox, Converter={StaticResource BoolToVisibility}}"
                    VerticalAlignment="Center" Focusable="False" />
          <StackPanel Grid.Column="1" Margin="0,0,10,0">
            <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding FolderPath}" Style="{StaticResource MutedText}" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Note}" TextWrapping="NoWrap" FontStyle="Italic">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                     TextWrapping="NoWrap" />
          <TextBlock Grid.Column="3" Text="{Binding DateText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                     VerticalAlignment="Center" TextWrapping="NoWrap" />
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Search -->
    <StackPanel>
      <TextBlock x:Name="Heading" Style="{StaticResource HeadingText}" />
      <TextBlock x:Name="IntroText" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,12,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="MinSizeLabel" VerticalAlignment="Center" Margin="0,0,6,0" />
      <ComboBox x:Name="MinSizeBox" Grid.Column="1" MinWidth="100" VerticalAlignment="Center" Margin="0,0,12,0" />
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="SearchButton" Style="{StaticResource PrimaryButton}" />
        <Button x:Name="CancelButton" />
      </StackPanel>
      <TextBlock x:Name="StatusText" Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource MutedText}" />
    </Grid>

    <!-- Groups -->
    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1" CornerRadius="10" Padding="10">
      <TabControl x:Name="Tabs" BorderThickness="0" Background="Transparent" Padding="0,8,0,0">
        <TabItem x:Name="LocalTab">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="LocalHint" Style="{StaticResource MutedText}" Margin="2,0,2,6" />
            <ListBox x:Name="LocalList" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrushSoft}"
                     Background="Transparent" ItemContainerStyle="{StaticResource RowStyle}" SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
              <ListBox.ContextMenu>
                <ContextMenu x:Name="LocalMenu">
                  <MenuItem x:Name="LocalRevealItem" />
                  <MenuItem x:Name="LocalCopyItem" />
                  <Separator />
                  <MenuItem x:Name="LocalFolderItem" />
                </ContextMenu>
              </ListBox.ContextMenu>
            </ListBox>
            <TextBlock x:Name="LocalEmpty" Grid.Row="1" Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextAlignment="Center" MaxWidth="560" />
          </Grid>
        </TabItem>
        <TabItem x:Name="SharesTab">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="SharesHint" Foreground="{StaticResource WarnBrush}" FontSize="12" Margin="2,0,2,6" />
            <ListBox x:Name="ShareList" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrushSoft}"
                     Background="Transparent" ItemContainerStyle="{StaticResource RowStyle}" SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
              <ListBox.ContextMenu>
                <ContextMenu x:Name="ShareMenu">
                  <MenuItem x:Name="ShareRevealItem" />
                  <MenuItem x:Name="ShareCopyItem" />
                </ContextMenu>
              </ListBox.ContextMenu>
            </ListBox>
            <TextBlock x:Name="SharesEmpty" Grid.Row="1" Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextAlignment="Center" MaxWidth="560" />
          </Grid>
        </TabItem>
      </TabControl>
    </Border>

    <!-- Actions -->
    <StackPanel Grid.Row="3" Margin="0,10,0,0">
      <WrapPanel>
        <Button x:Name="RevealButton" Margin="0,0,8,6" />
        <Button x:Name="CopyButton" Margin="0,0,8,6" />
        <Button x:Name="NewestButton" Margin="0,0,8,6" />
        <Button x:Name="FolderButton" Margin="0,0,8,6" />
        <Button x:Name="ClearButton" Margin="0,0,8,6" />
        <Button x:Name="RecycleButton" Margin="0,0,8,6" />
      </WrapPanel>
      <TextBlock x:Name="MarkedText" Margin="0,2,0,0" />
      <TextBlock x:Name="ActionMessage" Margin="0,6,0,0" FontSize="12" Visibility="Collapsed" />
    </StackPanel>
  </Grid>
</Window>
