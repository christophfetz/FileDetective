<Window x:Class="FileDetective.App.StorageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileDetective.App.ViewModels"
        Width="1040" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <Style x:Key="DriveRowStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Row" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="#F3F5F7" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="BarStyle" TargetType="ProgressBar">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Height" Value="8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="{StaticResource ChipBrush}" />
        <Setter Property="IsHitTestVisible" Value="False" />
      </Style>

      <!-- A tree item whose header stretches over the whole width, so the columns line up with the header row. -->
      <Style x:Key="FolderItemStyle" TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TreeViewItem">
              <StackPanel>
                <Border x:Name="Row" Background="Transparent" Padding="0,3,6,3" CornerRadius="4">
                  <Grid Margin="{Binding Indent}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="20" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                  ClickMode="Press" Focusable="False" VerticalAlignment="Center">
                      <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                          <Border Background="Transparent" Width="20" Height="20">
                            <TextBlock x:Name="Glyph" Text="&#x25B8;" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                              <Setter TargetName="Glyph" Property="Text" Value="&#x25BE;" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" />
                  </Grid>
                </Border>
                <ItemsPresenter x:Name="ItemsHost" />
              </StackPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="False">
                  <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="HasItems" Value="False">
                  <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                </Trigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="#F3F5F7" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnTreeItemRightClick" />
      </Style>

      <Style x:Key="FileItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="4,3" />
      </Style>

      <DataTemplate DataType="{x:Type vm:StorageDriveItem}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="300" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,10,0">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" ToolTip="{Binding Detail}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding KindText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <ProgressBar Style="{StaticResource BarStyle}" Value="{Binding UsedFraction, Mode=OneWay}"
                         Visibility="{Binding BarVisibility}" Margin="0,0,0,3" />
            <TextBlock Text="{Binding SpaceText}" Style="{StaticResource MutedText}" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SpaceText}" />
          </StackPanel>
        </Grid>
      </DataTemplate>

      <HierarchicalDataTemplate DataType="{x:Type vm:SpaceRow}" ItemsSource="{Binding Children}">
        <Grid ToolTip="{Binding ToolTip}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="86" />
            <ColumnDefinition Width="74" />
            <ColumnDefinition Width="130" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,10,0">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMutedRow}" Value="True">
                      <Setter Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" Visibility="{Binding NoteVisibility}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                     TextWrapping="NoWrap" />
          <Grid Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="{Binding BarVisibility}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <ProgressBar Style="{StaticResource BarStyle}" Value="{Binding Fraction, Mode=OneWay}" />
            <TextBlock Grid.Column="1" Text="{Binding PercentText}" Style="{StaticResource MutedText}"
                       HorizontalAlignment="Right" TextWrapping="NoWrap" />
          </Grid>
          <TextBlock Grid.Column="3" Text="{Binding FilesText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                     TextWrapping="NoWrap" />
          <TextBlock Grid.Column="4" Text="{Binding FoldersText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                     TextWrapping="NoWrap" />
          <TextBlock Grid.Column="5" Text="{Binding DateText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                     VerticalAlignment="Center" TextWrapping="NoWrap" />
        </Grid>
      </HierarchicalDataTemplate>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Drives and shares -->
    <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="DrivesHeading" Style="{StaticResource HeadingText}" VerticalAlignment="Center" />
      <!-- Only in the storage process with administrator rights (PLAN.md 11.1). -->
      <Border x:Name="AdminBadgeBox" Margin="12,0,0,0" Padding="8,2" CornerRadius="6" Background="{StaticResource WarnBrush}"
              VerticalAlignment="Center" Visibility="Collapsed">
        <TextBlock x:Name="AdminBadge" Foreground="White" FontWeight="SemiBold" />
      </Border>
    </StackPanel>
    <Border Grid.Row="1" Margin="0,10,0,0" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="6">
      <Grid>
        <ListBox x:Name="DriveList" BorderThickness="0" Background="Transparent" MaxHeight="180"
                 ItemContainerStyle="{StaticResource DriveRowStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        <TextBlock x:Name="DrivesEmpty" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,14" />
      </Grid>
    </Border>

    <!-- Actions on the selected drive -->
    <Grid Grid.Row="2" Margin="0,12,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="AnalyzeButton" Style="{StaticResource PrimaryButton}" />
        <Button x:Name="CancelButton" />
        <Button x:Name="AdminButton" Visibility="Collapsed" />
      </StackPanel>
      <TextBlock x:Name="StatusText" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource MutedText}" />
    </Grid>

    <!-- Folders and largest files -->
    <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1" CornerRadius="10" Padding="10">
      <Grid>
        <TabControl x:Name="Tabs" BorderThickness="0" Background="Transparent" Padding="0,8,0,0">
          <TabItem x:Name="FoldersTab">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Margin="28,0,29,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="86" />
                  <ColumnDefinition Width="74" />
                  <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderName" Style="{StaticResource MutedText}" />
                <TextBlock x:Name="HeaderSize" Grid.Column="1" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                <TextBlock x:Name="HeaderShare" Grid.Column="2" Style="{StaticResource MutedText}" Margin="14,0,0,0" />
                <TextBlock x:Name="HeaderFiles" Grid.Column="3" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                <TextBlock x:Name="HeaderFolders" Grid.Column="4" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                <TextBlock x:Name="HeaderModified" Grid.Column="5" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
              </Grid>
              <TreeView x:Name="FolderTree" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrushSoft}"
                        Background="Transparent" ItemContainerStyle="{StaticResource FolderItemStyle}"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <TreeView.ContextMenu>
                  <ContextMenu x:Name="TreeMenu">
                    <MenuItem x:Name="TreeRevealItem" />
                    <MenuItem x:Name="TreeCopyItem" />
                    <Separator />
                    <MenuItem x:Name="TreeRecycleItem" />
                    <MenuItem x:Name="TreeEmptyBinItem" />
                  </ContextMenu>
                </TreeView.ContextMenu>
              </TreeView>
            </Grid>
          </TabItem>
          <TabItem x:Name="FilesTab">
            <ListView x:Name="FileList" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrushSoft}"
                      Background="Transparent" ItemContainerStyle="{StaticResource FileItemStyle}"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectionMode="Single">
              <ListView.ContextMenu>
                <ContextMenu x:Name="FileMenu">
                  <MenuItem x:Name="FileRevealItem" />
                  <MenuItem x:Name="FileCopyItem" />
                  <Separator />
                  <MenuItem x:Name="FileRecycleItem" />
                </ContextMenu>
              </ListView.ContextMenu>
              <ListView.View>
                <GridView x:Name="FileGrid">
                  <GridViewColumn x:Name="FileNameColumn" Width="280" DisplayMemberBinding="{Binding Name}" />
                  <GridViewColumn x:Name="FilePathColumn" Width="400" DisplayMemberBinding="{Binding FolderPath}" />
                  <GridViewColumn x:Name="FileSizeColumn" Width="90">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" TextWrapping="NoWrap" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn x:Name="FileDateColumn" Width="140" DisplayMemberBinding="{Binding DateText}" />
                </GridView>
              </ListView.View>
            </ListView>
          </TabItem>
        </TabControl>
        <TextBlock x:Name="PlaceholderText" Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                   VerticalAlignment="Center" TextAlignment="Center" MaxWidth="560" />
      </Grid>
    </Border>

    <!-- Actions on the selected line -->
    <StackPanel Grid.Row="4" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="RevealButton" />
        <Button x:Name="CopyButton" />
        <Button x:Name="RecycleButton" />
        <Button x:Name="EmptyBinButton" />
      </StackPanel>
      <TextBlock x:Name="ActionMessage" Margin="0,8,0,0" FontSize="12" Visibility="Collapsed" />
      <TextBlock x:Name="LocalHint" Margin="0,8,0,0" Style="{StaticResource MutedText}" />
      <TextBlock x:Name="AdminHint" Margin="0,4,0,0" Style="{StaticResource MutedText}" Visibility="Collapsed" />
    </StackPanel>
  </Grid>
</Window>
