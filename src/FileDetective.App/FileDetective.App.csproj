<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\FileDetective.ico</ApplicationIcon>
    <NeutralLanguage>en</NeutralLanguage>
    <RootNamespace>FileDetective.App</RootNamespace>
    <AssemblyName>FileDetective</AssemblyName>
    <Product>FileDetective</Product>
    <Authors>Christoph Fetz</Authors>
    <Copyright>Copyright (c) 2026 Christoph Fetz, MIT License</Copyright>
    <!-- Version of the program (release tag is v + this). The workflow stops if the tag and this value differ. -->
    <Version>0.3.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileDetective.Core\FileDetective.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also embedded as a WPF resource: the tray icon is loaded from it in the size the system asks for. -->
    <Resource Include="Assets\FileDetective.ico" />
  </ItemGroup>

</Project>
