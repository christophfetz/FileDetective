<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile for the release (PLAN.md 9): self-contained, one exe for 64-bit Windows, including the .NET runtime
  and the native SQLite library (unpacked at the first start into %TEMP%\.net). Applies only to `dotnet publish`, never
  to `dotnet build` or `dotnet test`.

  dotnet publish src/FileDetective.App -c Release -p:PublishProfile=win-x64
  Result: publish/win-x64/FileDetective.exe (below the repository folder, ignored by git)
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
