<Window x:Class="FileDetective.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileDetective.App.ViewModels"
        xmlns:local="clr-namespace:FileDetective.App"
        Width="860" Height="620" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Row" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="{StaticResource ChipBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="ItemRowStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Row" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="#F3F5F7" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <DataTemplate DataType="{x:Type vm:LocationItem}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="86" />
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="76" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,10,0">
            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Path}" />
            <TextBlock Text="{Binding UncPath}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" Visibility="{Binding UncVisibility}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding KindText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     TextWrapping="NoWrap" Margin="0,0,8,0" ToolTip="{Binding StatusText}" />
          <TextBlock Grid.Column="3" Text="{Binding UpdatedText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                     TextWrapping="NoWrap" />
          <TextBlock Grid.Column="4" Text="{Binding EntriesText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                     TextWrapping="NoWrap" HorizontalAlignment="Right" />
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="190" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" Margin="0,4,12,0"
             ItemContainerStyle="{StaticResource NavItemStyle}" />

    <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1" CornerRadius="10" Padding="22,18">
      <Grid>
        <!-- Locations -->
        <Grid x:Name="LocationsPanel">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="LocationsHeading" Style="{StaticResource HeadingText}" />
          <Grid Grid.Row="1" Margin="8,14,26,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="86" />
              <ColumnDefinition Width="170" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="76" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HeaderPath" Style="{StaticResource MutedText}" />
            <TextBlock x:Name="HeaderKind" Grid.Column="1" Style="{StaticResource MutedText}" />
            <TextBlock x:Name="HeaderStatus" Grid.Column="2" Style="{StaticResource MutedText}" />
            <TextBlock x:Name="HeaderUpdated" Grid.Column="3" Style="{StaticResource MutedText}" />
            <TextBlock x:Name="HeaderEntries" Grid.Column="4" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
          </Grid>
          <Grid Grid.Row="2">
            <ListBox x:Name="LocationList" BorderThickness="0,1,0,1" BorderBrush="{StaticResource BorderBrushSoft}"
                     Background="Transparent" ItemContainerStyle="{StaticResource ItemRowStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            <TextBlock x:Name="LocationsEmpty" Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Grid>
          <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="PathBox" Margin="0,0,8,0" />
              <Button x:Name="BrowseButton" Grid.Column="1" />
              <Button x:Name="AddButton" Grid.Column="2" Margin="0" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button x:Name="UpdateButton" />
              <Button x:Name="RemoveButton" />
            </StackPanel>
            <TextBlock x:Name="LocationsMessage" Margin="0,8,0,0" FontSize="12" Visibility="Collapsed" />
          </StackPanel>
          <TextBlock x:Name="LocationsHint" Grid.Row="4" Margin="0,10,0,0" Style="{StaticResource MutedText}" />
        </Grid>

        <!-- Exclusions -->
        <ScrollViewer x:Name="ExclusionsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="0,0,10,0">
            <TextBlock x:Name="ExclusionsHeading" Style="{StaticResource HeadingText}" />
            <TextBlock x:Name="ExclusionsIntro" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
            <TextBlock x:Name="FoldersLabel" Style="{StaticResource LabelText}" />
            <TextBox x:Name="FoldersBox" AcceptsReturn="True" Height="100" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" />
            <TextBlock x:Name="FoldersHint" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            <TextBlock x:Name="PathsLabel" Style="{StaticResource LabelText}" />
            <TextBox x:Name="PathsBox" AcceptsReturn="True" Height="100" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" />
            <TextBlock x:Name="PathsHint" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            <TextBlock x:Name="FilesLabel" Style="{StaticResource LabelText}" />
            <TextBox x:Name="FilesBox" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" />
            <TextBlock x:Name="FilesHint" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            <TextBlock x:Name="SystemHint" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
            <Button x:Name="ResetExclusionsButton" HorizontalAlignment="Left" Margin="0,14,0,0" />
          </StackPanel>
        </ScrollViewer>

        <!-- General -->
        <ScrollViewer x:Name="GeneralPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="0,0,10,0">
            <TextBlock x:Name="GeneralHeading" Style="{StaticResource HeadingText}" />

            <TextBlock x:Name="HotkeyLabel" Style="{StaticResource LabelText}" />
            <StackPanel Orientation="Horizontal">
              <local:HotkeyCaptureBox x:Name="HotkeyBox" Width="220" />
              <Button x:Name="HotkeyResetButton" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="HotkeyMessage" Margin="0,6,0,0" FontSize="12" />

            <TextBlock x:Name="StartupLabel" Style="{StaticResource LabelText}" />
            <CheckBox x:Name="AutostartBox" />
            <TextBlock x:Name="AutostartMessage" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource WarnBrush}"
                       Visibility="Collapsed" />

            <TextBlock x:Name="LanguageLabel" Style="{StaticResource LabelText}" />
            <ComboBox x:Name="LanguageBox" HorizontalAlignment="Left" Width="220" />
            <TextBlock x:Name="LanguageHint" Style="{StaticResource MutedText}" Margin="0,4,0,0" />

            <TextBlock x:Name="UpdatesLabel" Style="{StaticResource LabelText}" />
            <CheckBox x:Name="UpdatesBox" />

            <TextBlock x:Name="PolitenessLabel" Style="{StaticResource LabelText}" />
            <ComboBox x:Name="PolitenessBox" HorizontalAlignment="Left" Width="320" />
            <TextBlock x:Name="PolitenessHint" Style="{StaticResource MutedText}" Margin="0,4,0,0" />

            <TextBlock x:Name="RebuildLabel" Style="{StaticResource LabelText}" />
            <Button x:Name="RebuildButton" HorizontalAlignment="Left" Margin="0" />
            <TextBlock x:Name="RebuildHint" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            <TextBlock x:Name="RebuildMessage" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
          </StackPanel>
        </ScrollViewer>

        <!-- About -->
        <ScrollViewer x:Name="AboutPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="0,0,10,0">
            <TextBlock x:Name="AboutHeading" Style="{StaticResource HeadingText}" />
            <TextBlock x:Name="VersionText" Margin="0,12,0,0" />
            <TextBlock x:Name="LicenseText" Margin="0,6,0,0" />
            <TextBlock x:Name="RepositoryText" Margin="0,6,0,0">
              <Hyperlink x:Name="RepositoryLink" />
            </TextBlock>
            <TextBlock x:Name="DataLabel" Style="{StaticResource LabelText}" Margin="0,22,0,4" />
            <TextBox x:Name="DataPathBox" IsReadOnly="True" />
            <Button x:Name="OpenDataButton" HorizontalAlignment="Left" Margin="0,10,0,0" />
            <TextBlock x:Name="PrivacyText" Style="{StaticResource MutedText}" Margin="0,22,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Window>
